{
  "name": "aicfo-workspace",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:mobile",
    "build": "npm run build:web && npm run build:mobile",
    "prepare:mobile": "node scripts/prepare-mobile-v2.mjs",
    "dev:web": "vite --config apps/web-v2/vite.config.ts",
    "build:web": "tsc -p apps/web-v2/tsconfig.json && vite build --config apps/web-v2/vite.config.ts",
    "preview:web": "vite preview --config apps/web-v2/vite.config.ts",
    "dev:mobile": "npm run prepare:mobile && cd apps/mobile-v2 && HOST=127.0.0.1 PORT=4173 BROWSER=none roadhog dev",
    "build:mobile": "npm run prepare:mobile && cd apps/mobile-v2 && roadhog build",
    "preview:mobile": "echo 'roadhog mobile preview uses dev server on port 4173'"
  },
  "dependencies": {
    "antd": "4.23.0",
    "antd-mobile": "2.3.4",
    "echarts": "4.9.0",
    "react": "16.14.0",
    "react-dom": "16.14.0"
  },
  "devDependencies": {
    "@types/react": "16.14.24",
    "@types/react-dom": "16.9.19",
    "@vitejs/plugin-react": "5.1.1",
    "less": "4.2.0",
    "roadhog": "2.5.0-beta.4",
    "typescript": "^5.8.3",
    "vite": "7.3.1"
  }
}
