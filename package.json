{
  "name": "aicfo-workspace",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/mobile/vite.config.js",
    "build": "tsc -p apps/mobile/tsconfig.json && vite build --config apps/mobile/vite.config.js",
    "preview": "vite preview --config apps/mobile/vite.config.js",
    "dev:mobile": "npm run dev",
    "build:mobile": "npm run build",
    "preview:mobile": "npm run preview"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^5.6.0",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^6.30.1",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.4.21",
    "less": "^4.6.4",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
